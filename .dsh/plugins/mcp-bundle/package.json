{
  "name": "@local/mcp-bundle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optional MCP servers (MySQL ×3 environments, Tencent COS) shipped as a dsh bundle layer. Entries stay disabled until their environment variables exist.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walkvoid/dshworkspace.git",
    "directory": ".dsh/plugins/mcp-bundle"
  },
  "scripts": {
    "enable": "node scripts/enable.mjs",
    "check": "node scripts/enable.mjs --dry-run"
  },
  "exports": {
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    ".env.example",
    "scripts/enable.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
