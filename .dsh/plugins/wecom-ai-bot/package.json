{
  "name": "dsh-wecom-ai-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bridge a WeCom (企业微信) smart bot to DeepSeek Harness with a global on/off switch, administrator-in-group auto authorization, first-contact admin grants, and per-person or per-group authorization scoped to a single workspace, with editable nicknames.",
  "license": "MIT",
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "config.js",
    "protocol.js",
    "store.js",
    "format.js",
    "status.js",
    "observation.js",
    "turns.js",
    "bridge.js",
    "runtime.js",
    "message-log.js",
    "routes.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "@wecom/aibot-node-sdk": "1.0.7"
  },
  "engines": {
    "node": ">=22"
  }
}
