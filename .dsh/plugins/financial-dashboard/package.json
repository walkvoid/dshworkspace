{
  "name": "@local/financial-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Right-sidebar financial dashboard: index and watchlist quotes, a 120-day candlestick chart, and a daily turtle-picks screener with history.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walkvoid/dshworkspace.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test-route.mjs",
    "test:picks": "node scripts/test-picks.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "picks.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses/*.txt",
    "scripts/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
