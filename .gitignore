node_modules/
.cache/
*.tgz
*.log
.DS_Store
Thumbs.db

# Third-party skill config carries an API key; it must never be committed.
.dsh/skills/*/mcp_config.json

# Environment-prep output holds database and nacos credentials in clear text.
.env-prep/
*.env-profile.json

# Requirement analysis output quotes PRDs, which are often confidential.
.requirements/

# 9c video transcripts/prompts are local research material; only distilled claims belong in the repo.
.dsh/skills/9c/knowledge/transcripts/*.md
!.dsh/skills/9c/knowledge/transcripts/README.md
.dsh/skills/9c/knowledge/prompts/*.md
.dsh/skills/9c/knowledge/prompts/*.jsonl
.dsh/skills/9c/knowledge/docs/*.md
!.dsh/skills/9c/knowledge/docs/README.md
.dsh/skills/9c/knowledge/*.bak

# Cloned project workspaces (repos + their .env-prep) never belong to this repo.
/project/

# IDE state, at any depth: the dashboard is its own package and may be opened separately.
.idea/
*.iml

# 看板运行期数据：每日选股结果与历史（本地，不入库）
.dsh/plugins/financial-dashboard/.data/
