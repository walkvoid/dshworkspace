# 复制到 .env-prep/cos-mcp.env 后填写；.env-prep/ 已被 gitignore。
# 密钥在 https://console.cloud.tencent.com/cam/capi 生成，建议用只授权 COS 的子账号。
COS_REGION=ap-guangzhou
COS_BUCKET=your-bucket-1250000000
COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选：数据万象 MetaInsight 数据集名，只有图文检索需要
# COS_DATASET_NAME=
